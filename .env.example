# Secrets for logwatch. Copy to .env (chmod 600) and point env_file at it.
# Keep comments on their own lines: older Compose versions treat a trailing
# "# ..." as part of the value.

# Claude API (only needed for MODE=claude or MODE=hybrid)
ANTHROPIC_API_KEY=sk-ant-...
# Haiku costs about a third of Sonnet; omit to use the default model
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Email (Gmail needs an App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASS=your-app-password
MAIL_TO=you@gmail.com
